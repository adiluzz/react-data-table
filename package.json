{
  "name": "react-turbo-table",
  "version": "1.1.8",
  "description": "A fast, feature-rich React table component with grouping, sorting, filtering, and pagination capabilities. Built with Material UI.",
  "type": "module",
  "license": "MIT",
  "author": "Adi Iluz",
  "repository": {
    "type": "git",
    "url": "https://github.com/adiluzz/react-turbo-table.git"
  },
  "bugs": {
    "url": "https://github.com/adiluzz/react-turbo-table/issues"
  },
  "homepage": "https://github.com/adiluzz/react-turbo-table#readme",
  "keywords": [
    "react",
    "table",
    "data-table",
    "material-ui",
    "mui",
    "grouping",
    "sorting",
    "filtering",
    "pagination",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/react-turbo-table.es.js",
      "require": "./dist/react-turbo-table.umd.js",
      "types": "./dist/src/main.d.ts"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "main": "./dist/react-turbo-table.umd.js",
  "module": "./dist/react-turbo-table.es.js",
  "types": "./dist/src/main.d.ts",
  "scripts": {
    "dev": "cd src/examples && MODE=dev vite",
    "build": "vite build && tsc",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/estree": "^1.0.5"
  },
  "devDependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.17",
    "@mui/material": "^5.15.17",
    "@rollup/plugin-typescript": "^8.2.1",
    "@types/node": "^20.14.9",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup-plugin-typescript-paths": "^1.3.0",
    "styled-components": "^6.1.11",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^1.4.1",
    "vite-plugin-linter": "^1.2.0",
    "vite-tsconfig-paths": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "@mui/material": "^5.0.0",
    "@mui/icons-material": "^5.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0"
  }
}